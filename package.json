{
  "name": "lab-core",
  "private": true,
  "workspaces": [
    "core/backend",
    "core/dashboard",
    "sdk",
    "sdk/packages/*"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1"
  },
  "scripts": {
    "sdk:labcore": "corepack yarn workspace @lab-core/sdk-cli run cli",
    "sdk:build": "corepack yarn workspace @lab-core/sdk-monorepo run build",
    "sdk:test": "corepack yarn workspace @lab-core/sdk-monorepo run test",
    "launcher": "corepack yarn tsx scripts/tasks/interactive-tasks.ts",
    "config": "corepack yarn tsx scripts/dev/root-command.ts config",
    "destroy": "corepack yarn tsx scripts/dev/root-command.ts destroy",
    "environment:dev:up": "corepack yarn tsx scripts/dev/root-command.ts environment:dev:up",
    "environment:dev:down": "corepack yarn tsx scripts/dev/root-command.ts environment:dev:down",
    "environment:dev:logs": "corepack yarn tsx scripts/dev/root-command.ts environment:dev:logs",
    "environment:lab:up": "corepack yarn tsx scripts/dev/root-command.ts environment:lab:up",
    "environment:lab:down": "corepack yarn tsx scripts/dev/root-command.ts environment:lab:down",
    "environment:lab:logs": "corepack yarn tsx scripts/dev/root-command.ts environment:lab:logs",
    "service:backend:up": "corepack yarn tsx scripts/dev/root-command.ts service:backend:up",
    "service:dashboard:up": "corepack yarn tsx scripts/dev/root-command.ts service:dashboard:up",
    "quality:build": "corepack yarn tsx scripts/dev/root-command.ts quality:build",
    "quality:typecheck:scripts": "corepack yarn tsx scripts/dev/root-command.ts quality:typecheck:scripts",
    "quality:test:smoke": "corepack yarn tsx scripts/dev/root-command.ts quality:test:smoke",
    "quality:test:fixtures": "corepack yarn tsx scripts/dev/root-command.ts quality:test:fixtures"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
