    "dev:dashboard": "corepack yarn tsx scripts/dev/root-command.ts dev:dashboard",
    "dev:core:deps": "corepack yarn tsx scripts/dev/root-command.ts dev:core:deps",
    "dev:core:up": "corepack yarn tsx scripts/dev/root-command.ts dev:core:up",
    "dev:core:down": "corepack yarn tsx scripts/dev/root-command.ts dev:core:down",
    "dev:core:logs": "corepack yarn tsx scripts/dev/root-command.ts dev:core:logs",
    "dev:kernel:logs": "corepack yarn tsx scripts/dev/root-command.ts dev:kernel:logs",
