  "private": true,
  "workspaces": [
    "core/backend",
    "core/dashboard"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1"
  },
  "scripts": {
    "dev": "corepack yarn tsx scripts/dev/root-command.ts dev",
