{
  "name": "lab-core",
  "private": true,
  "workspaces": [
    "core/backend",
    "core/dashboard",
    "sdk",
    "sdk/packages/*"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1"
  },
  "scripts": {
    "launcher": "corepack yarn tsx scripts/tasks/interactive-tasks.ts",
    "config:set": "corepack yarn tsx scripts/dev/root-command.ts config:set",
    "config:show": "corepack yarn tsx scripts/dev/root-command.ts config:show",
    "config:edit": "corepack yarn tsx scripts/dev/root-command.ts config:edit",
    "destroy": "corepack yarn tsx scripts/dev/root-command.ts destroy",
    "system:up": "corepack yarn tsx scripts/dev/root-command.ts system:up",
    "system:down": "corepack yarn tsx scripts/dev/root-command.ts system:down",
    "system:logs": "corepack yarn tsx scripts/dev/root-command.ts system:logs",
    "permissions:repair": "corepack yarn tsx scripts/dev/root-command.ts permissions:repair",
    "service:backend:up": "corepack yarn tsx scripts/dev/root-command.ts service:backend:up",
    "service:dashboard:up": "corepack yarn tsx scripts/dev/root-command.ts service:dashboard:up",
    "quality:build": "corepack yarn tsx scripts/dev/root-command.ts quality:build",
    "quality:typecheck:scripts": "corepack yarn tsx scripts/dev/root-command.ts quality:typecheck:scripts",
    "quality:test:smoke": "corepack yarn tsx scripts/dev/root-command.ts quality:test:smoke",
    "quality:test:fixtures": "corepack yarn tsx scripts/dev/root-command.ts quality:test:fixtures"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
