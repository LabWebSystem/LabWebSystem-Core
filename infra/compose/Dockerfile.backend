FROM node:22-bookworm-slim AS build

WORKDIR /build
COPY . .

RUN corepack enable \
  && yarn install --immutable \
  && yarn workspace @lab-core/sdk-contract build \
  && yarn workspace @lab-core/backend build

# Runtime still contains the built application and its workspace dependencies,
# but does not require Node.js/Yarn/Git on the host or a repository mount.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV LAB_CORE_CONFIG_PATH=/etc/labwebsystem/config.yaml

COPY --from=build /build/package.json /build/yarn.lock /build/.yarnrc.yml ./
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/core/backend/package.json ./core/backend/package.json
COPY --from=build /build/core/backend/dist ./core/backend/dist
COPY --from=build /build/core/backend/openapi ./core/backend/openapi
COPY --from=build /build/sdk/packages/sdk-contract/package.json ./sdk/packages/sdk-contract/package.json
COPY --from=build /build/sdk/packages/sdk-contract/dist ./sdk/packages/sdk-contract/dist

EXPOSE 7300
ENTRYPOINT ["node", "core/backend/dist/index.js"]
