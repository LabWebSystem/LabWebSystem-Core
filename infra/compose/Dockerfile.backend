FROM node:22-bookworm-slim AS build

WORKDIR /build
COPY . .

RUN corepack enable \
  && yarn install --immutable \
  && yarn workspace @lab-core/sdk-contract build \
  && yarn workspace @lab-core/backend build

# Runtime still contains the built application and its workspace dependencies,
# but does not require Node.js/Yarn/Git on the host or a repository mount.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

# Production operations use the Docker socket for resource inspection and
# docker compose for application lifecycle actions. The host does not need
# Docker CLI or Compose because these are part of the Backend runtime image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
  && chmod a+r /etc/apt/keyrings/docker.asc \
  && printf '%s\n' \
    'Types: deb' \
    'URIs: https://download.docker.com/linux/debian' \
    'Suites: bookworm' \
    'Components: stable' \
    "Architectures: $(dpkg --print-architecture)" \
    'Signed-By: /etc/apt/keyrings/docker.asc' \
    > /etc/apt/sources.list.d/docker.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
  && rm -rf /var/lib/apt/lists/* /etc/apt/keyrings/docker.asc /etc/apt/sources.list.d/docker.sources

COPY --from=build /build/package.json /build/yarn.lock /build/.yarnrc.yml ./
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/core/backend/package.json ./core/backend/package.json
COPY --from=build /build/core/backend/dist ./core/backend/dist
COPY --from=build /build/core/backend/openapi ./core/backend/openapi
COPY --from=build /build/sdk/packages/sdk-contract/package.json ./sdk/packages/sdk-contract/package.json
COPY --from=build /build/sdk/packages/sdk-contract/dist ./sdk/packages/sdk-contract/dist

EXPOSE 7300
ENTRYPOINT ["node", "core/backend/dist/index.js"]
