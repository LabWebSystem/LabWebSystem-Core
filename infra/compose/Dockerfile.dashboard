FROM node:22-bookworm-slim AS build

WORKDIR /build
COPY . .

RUN corepack enable \
  && yarn install --immutable \
  && yarn workspace @lab-core/dashboard build

FROM nginx:1.27-alpine

COPY infra/compose/nginx.dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/core/dashboard/dist /usr/share/nginx/html

EXPOSE 80
